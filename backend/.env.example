# ============================================================
# InterviewCopilot AI — Environment Configuration
# Copy this to .env and fill in all values before running.
# NEVER commit .env to source control.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_NAME="InterviewCopilot AI"
ENV=development                             # development | staging | production
DEBUG=true
SECRET_KEY=your-super-secret-key-here       # openssl rand -hex 32
FRONTEND_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://interviewcopilot:password@localhost:5432/interviewcopilot
DB_POOL_SIZE=10
DB_POOL_OVERFLOW=20

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_POOL_SIZE=20

# ── JWT (RS256) ───────────────────────────────────────────────
# Generate with: openssl genrsa -out private.pem 2048
#                openssl rsa -in private.pem -pubout -out public.pem
PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_WHISPER_MODEL=whisper-1

# ── Google Gemini ─────────────────────────────────────────────
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-1.5-pro

# ── Google Cloud Storage (GCS) ─────────────────────────────────
GCS_BUCKET_NAME=interviewcopilot-resumes
# Optional: path to a service account JSON file for local development. If
# omitted, the runtime will use Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ── Razorpay ──────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
RAZORPAY_PRO_PLAN_ID=plan_...
RAZORPAY_ENTERPRISE_PLAN_ID=plan_...

# ── Sentry (optional) ─────────────────────────────────────────
# SENTRY_DSN=https://...@sentry.io/...
